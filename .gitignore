# Rust
/target/
**/*.rs.bk
# `src-tauri/` is a workspace member, so the workspace root `Cargo.lock`
# is authoritative. The `src-tauri/Cargo.lock` is a vestigial artifact
# from before the workspace migration — never updated by cargo.
src-tauri/Cargo.lock

# Node / Frontend
node_modules/
dist/
build/
.svelte-kit/
coverage/

# Playwright (visual regression suite)
test-results/
playwright-report/
playwright/.cache/

# Tauri
src-tauri/target/

# Staging area for regenerated marketing screenshots (promoted into
# assets/screenshots/ once approved — see scripts/build-screenshots.mjs)
docs/assets/screenshots/_new/

# Mobile icons (desktop app only)
src-tauri/icons/android/
src-tauri/icons/ios/

# Git worktrees
.worktrees/

# BeardGit-managed AI background-run worktrees, scratch state, per-app caches
.beardgit/

# Environment
.env
.env.local

# Paraglide generated output
src/lib/paraglide/

# Bundled CLI binaries (downloaded by scripts/download-cli-binaries.js)
src-tauri/binaries/

# Personal tooling (AI assistants, IDE, notes) is NOT listed here on purpose:
# it lives in .git/info/exclude (this clone) and ~/.config/git/ignore (all repos).
